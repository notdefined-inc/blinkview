{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openfoto",
  "version": "0.0.1",
  "identifier": "dev.notdefined.openfoto",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "openfoto",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#0b0b0e"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/**",
          "$HOME/**",
          "$DESKTOP/**",
          "$PICTURE/**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
