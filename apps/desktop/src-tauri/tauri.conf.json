{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blinkview",
  "version": "0.1.2",
  "identifier": "dev.notdefined.blinkview",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blinkview",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#0b0b0e",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/**",
          "$HOME/**",
          "$DESKTOP/**",
          "$PICTURE/**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A photo manager that treats your folders as the truth.",
    "longDescription": "Blinkview reads the folders you already have. No import, no library file, no cloud, no account. Face recognition and search by what a photograph shows both run on your machine. Delete Blinkview and your folders are untouched.",
    "copyright": "GPL-3.0-or-later",
    "category": "Photography",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
