{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dev-bridge",
  "description": "The UI-verification bridge, for development builds only. build.rs removes this file unless the ui-bridge feature is enabled, so a release build never sees it.",
  "windows": [
    "main"
  ],
  "permissions": [
    "mcp-bridge:default"
  ]
}
